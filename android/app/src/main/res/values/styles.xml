<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">#12372A</item>
        <item name="colorPrimary">#1B3B2B</item>
        <item name="colorPrimaryDark">#12372A</item>
        <item name="colorAccent">#1B3B2B</item>
        <item name="android:colorAccent">#1B3B2B</item>
        <item name="android:colorPrimary">#1B3B2B</item>
        <item name="android:datePickerDialogTheme">@style/FpDatePicker</item>
    </style>

    <style name="FpDatePicker" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorPrimary">#1B3B2B</item>
        <item name="colorPrimaryDark">#12372A</item>
        <item name="colorAccent">#1B3B2B</item>
        <item name="android:colorAccent">#1B3B2B</item>
        <item name="android:colorPrimary">#1B3B2B</item>
        <item name="android:windowBackground">@drawable/fp_dialog_bg</item>
        <item name="android:textColorPrimary">#1C2A22</item>
        <item name="android:buttonBarButtonStyle">@style/FpDlgBtn</item>
    </style>
    <style name="FpDlgBtn" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#1B3B2B</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>